<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Nectar</RootNamespace>
    <AssemblyName>Nectar</AssemblyName>
    <Version>2.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\nectar.ico</ApplicationIcon>

    <!-- Unpackaged desktop app: no MSIX, no primary window, launched hidden. -->
    <WindowsPackageType>None</WindowsPackageType>
    <UseWinUI>true</UseWinUI>
    <!-- Use the Windows App SDK's own MSIX/PRI tooling (dotnet CLI friendly) instead of the
         Visual Studio-only AppxPackage tasks. -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <!-- Ship the Windows App SDK runtime next to the exe so the overlay does not depend on
         the machine-wide WindowsAppRuntime package version. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!-- SQLCipher: .Core is the EF provider without a bundled SQLite, so the cipher native
         library below is the only provider in the process. Mixing in bundle_e_sqlite3 makes the
         app load whichever native DLL wins and breaks PRAGMA key at runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="8.0.33" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
  </ItemGroup>

  <!-- Brand assets: tile/splash logos for the packaged build, the executable icon and the
       in-app hummingbird mark. Copied next to the exe so ms-appx:///Assets resolves in the
       unpackaged build too. -->
  <ItemGroup>
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Focus-expiry chime. Drop bird-sound.wav (or .mp3/.m4a) into Assets and it is copied
         next to the executable; no other change is needed. -->
    <Content Include="Assets\*.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.mp3" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.m4a" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Reference-only: the packaged identity manifest kept for an MSIX build. Not compiled into
       the unpackaged build. -->
  <ItemGroup>
  </ItemGroup>

</Project>
