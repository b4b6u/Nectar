<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Nectar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Nectar.ViewModels"
    mc:Ignorable="d"
    Title="Nectar">

    <Grid
        x:Name="Root"
        Margin="0"
        Background="#000000"
        Loaded="OnRootLoaded">
        <Grid.Resources>
            <Storyboard x:Key="ExpandStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="WorkspaceSurface"
                    Storyboard.TargetProperty="Height"
                    From="0"
                    To="340"
                    Duration="0:0:0.32"
                    EnableDependentAnimation="True">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="WorkspaceSurface"
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    BeginTime="0:0:0.04"
                    Duration="0:0:0.20"
                    EnableDependentAnimation="True" />
            </Storyboard>

            <Storyboard x:Key="CollapseStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="WorkspaceSurface"
                    Storyboard.TargetProperty="Height"
                    From="340"
                    To="0"
                    Duration="0:0:0.22"
                    EnableDependentAnimation="True">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="WorkspaceSurface"
                    Storyboard.TargetProperty="Opacity"
                    From="1"
                    To="0"
                    Duration="0:0:0.15"
                    EnableDependentAnimation="True" />
            </Storyboard>
        </Grid.Resources>

        <!-- ===== Collapsed pill ===== -->
        <Border
            x:Name="PillSurface"
            Width="200"
            Height="30"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Background="{StaticResource NectarShellBrush}"
            BorderThickness="0"
            CornerRadius="15"
            PointerEntered="OnPillPointerEntered">
            <Grid Padding="12,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/nectar-mark.png"
                    Stretch="Uniform" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    CharacterSpacing="140"
                    Foreground="{StaticResource NectarShellTextBrush}"
                    Text="NECTAR" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="11"
                    Foreground="{StaticResource NectarShellTextMutedBrush}"
                    Text="{x:Bind ViewModel.Timer.Display, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- ===== Focus-expiry tray: dropped down only while the workspace is closed ===== -->
        <Border
            x:Name="TimerExpiryTray"
            Width="560"
            Height="92"
            Padding="14,12"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#000000"
            BorderThickness="0"
            CornerRadius="24"
            PointerEntered="OnWorkspacePointerEntered"
            Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/nectar-mark.png"
                    Stretch="Uniform" />

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="TrayTaskName"
                        MaxLines="1"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NectarShellTextBrush}"
                        Text="Focus session"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="TrayTimeLabel"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="11"
                        Foreground="{StaticResource NectarShellTextMutedBrush}"
                        Text="11:21 PM" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">

                    <!-- Focus expiry: extend chips + Done -->
                    <StackPanel
                        x:Name="TrayFocusActions"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="10.5"
                            Foreground="{StaticResource NectarShellTextMutedBrush}"
                            Text="Extend" />

                        <Border
                            Padding="3"
                            Background="#1C1C1C"
                            BorderThickness="0"
                            CornerRadius="16">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button
                                    AutomationProperties.Name="Extend the focus session by 5 minutes"
                                    Background="{x:Bind ViewModel.Extend5Background, Mode=OneWay}"
                                    Click="OnTrayExtendClick"
                                    Foreground="{x:Bind ViewModel.Extend5Foreground, Mode=OneWay}"
                                    Style="{StaticResource TrayChipButtonStyle}"
                                    Tag="5">
                                    <TextBlock Text="5 min" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Extend the focus session by 10 minutes"
                                    Background="{x:Bind ViewModel.Extend10Background, Mode=OneWay}"
                                    Click="OnTrayExtendClick"
                                    Foreground="{x:Bind ViewModel.Extend10Foreground, Mode=OneWay}"
                                    Style="{StaticResource TrayChipButtonStyle}"
                                    Tag="10">
                                    <TextBlock Text="10 min" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Extend the focus session by 15 minutes"
                                    Background="{x:Bind ViewModel.Extend15Background, Mode=OneWay}"
                                    Click="OnTrayExtendClick"
                                    Foreground="{x:Bind ViewModel.Extend15Foreground, Mode=OneWay}"
                                    Style="{StaticResource TrayChipButtonStyle}"
                                    Tag="15">
                                    <TextBlock Text="15 min" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Button
                            AutomationProperties.Name="Complete the focused task"
                            Background="#F29C38"
                            Click="OnTrayDoneClick"
                            Foreground="#FF0A0A0A"
                            Style="{StaticResource TrayActionButtonStyle}">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="&#x2713; Done" />
                        </Button>
                    </StackPanel>

                    <!-- Calendar reminder: snooze + Okay, same tray, no extend -->
                    <StackPanel
                        x:Name="TrayReminderActions"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="10.5"
                            Foreground="{StaticResource NectarShellTextMutedBrush}"
                            Text="Remind me" />
                        <Button
                            AutomationProperties.Name="Snooze the reminder for 5 minutes"
                            Background="#262626"
                            Click="OnTraySnoozeClick"
                            Foreground="#E6FFFFFF"
                            Style="{StaticResource TrayChipButtonStyle}">
                            <TextBlock Text="Snooze 5 min" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Dismiss the reminder"
                            Background="#F29C38"
                            Click="OnTrayOkayClick"
                            Foreground="#FF0A0A0A"
                            Style="{StaticResource TrayActionButtonStyle}">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="&#x2713; Okay" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Expanded workspace ===== -->
        <Border
            x:Name="WorkspaceSurface"
            Width="1000"
            Height="0"
            Padding="10"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Background="{StaticResource NectarShellBrush}"
            BorderThickness="0"
            CornerRadius="26"
            Opacity="0"
            Visibility="Collapsed"
            PointerEntered="OnWorkspacePointerEntered"
            PointerExited="OnWorkspacePointerExited">

            <Grid x:Name="ShellContent" Height="320" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Shell top bar -->
                <Grid Padding="6,0,2,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Width="30"
                        Height="30"
                        VerticalAlignment="Center"
                        Source="ms-appx:///Assets/nectar-mark.png"
                        Stretch="Uniform" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NectarShellTextBrush}"
                        Text="Nectar" />

                    <Border
                        Grid.Column="2"
                        MaxWidth="380"
                        Padding="8,3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#33F38BA8"
                        CornerRadius="9"
                        Visibility="{x:Bind ViewModel.BannerVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10.5"
                                Foreground="{StaticResource NectarDangerBrush}"
                                Text="{x:Bind ViewModel.Banner, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Width="16"
                                Height="16"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnDismissBannerClick"
                                CornerRadius="8">
                                <FontIcon FontSize="8" Foreground="{StaticResource NectarDangerBrush}" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="3"
                        Padding="3"
                        VerticalAlignment="Center"
                        Background="{StaticResource NectarTabTrackBrush}"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button
                                x:Name="WorkspaceTabButton"
                                Click="OnWorkspaceTabClick"
                                Content="Workspace"
                                Style="{StaticResource ShellTabButtonStyle}" />
                            <Button
                                x:Name="InsightsTabButton"
                                Click="OnInsightsTabClick"
                                Content="Insights"
                                Style="{StaticResource ShellTabButtonStyle}" />
                            <Button
                                x:Name="CustomizeTabButton"
                                Click="OnCustomizeTabClick"
                                Content="Customize"
                                Style="{StaticResource ShellTabButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Button
                        Grid.Column="4"
                        Click="OnCollapseClick"
                        Style="{StaticResource ShellIconButtonStyle}"
                        ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon FontSize="10" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <!-- ===== Workspace view: the four lanes ===== -->
                <StackPanel
                    x:Name="WorkspaceView"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="8">

                    <!-- Tasks -->
                    <Border
                        x:Name="TasksCard"
                        Width="{x:Bind ViewModel.CardWidth, Mode=OneWay}"
                        Padding="13,10"
                        Background="{StaticResource NectarMintCardBrush}"
                        BorderThickness="0"
                        CornerRadius="18"
                        Visibility="{x:Bind ViewModel.TasksCardVisibility, Mode=OneWay}">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>                                <Rectangle
                                    Grid.RowSpan="4"
                                    Fill="{StaticResource NectarPaperGrainBrush}"
                                    IsHitTestVisible="False" Opacity="0.55" />



                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="12" Foreground="{StaticResource NectarInkMutedBrush}" Glyph="&#xE9D5;" />
                                <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="Today's tasks" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                <Border Padding="8,3" Background="{StaticResource NectarChipActiveBrush}" CornerRadius="9">
                                    <TextBlock Style="{StaticResource CardChipTextStyle}" Text="{x:Bind ViewModel.TaskOpenChip, Mode=OneWay}" />
                                </Border>
                                <Border Padding="8,3" Background="{StaticResource NectarChipBrush}" CornerRadius="9">
                                    <TextBlock
                                        Foreground="{StaticResource NectarInkMutedBrush}"
                                        Style="{StaticResource CardChipTextStyle}"
                                        Text="{x:Bind ViewModel.TaskDoneChip, Mode=OneWay}" />
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <ListView
                                    x:Name="TaskList"
                                    Padding="0"
                                    Background="Transparent"
                                    ItemContainerStyle="{StaticResource CardItemContainerStyle}"
                                    ItemsSource="{x:Bind ViewModel.Tasks}"
                                    SelectionMode="None"
                                    ScrollViewer.HorizontalScrollMode="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TaskRow">
                                            <StackPanel>
                                            <Border
                                                Padding="9,5"
                                                Background="{StaticResource NectarRowBrush}"
                                                BorderThickness="0"
                                                CornerRadius="10">
                                                <Grid ColumnSpacing="9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Width="18" Height="18" VerticalAlignment="Top">
                                                        <Ellipse
                                                            Fill="{x:Bind DialFill, Mode=OneWay}"
                                                            Stroke="{x:Bind DialStroke, Mode=OneWay}"
                                                            StrokeThickness="1.4" />
                                                        <FontIcon
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="9"
                                                            Foreground="White"
                                                            Glyph="&#xE73E;"
                                                            Opacity="{x:Bind CheckGlyphOpacity, Mode=OneWay}" />
                                                        <CheckBox
                                                            Width="18"
                                                            Height="18"
                                                            MinWidth="18"
                                                            VerticalAlignment="Center"
                                                            IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                                                            Opacity="0" />
                                                    </Grid>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Spacing="2"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource NectarInkBrush}"
                                                            MaxLines="1"
                                                            Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                                            Text="{x:Bind Title}"
                                                            TextDecorations="{x:Bind TitleDecorations, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap" />
                                                        <TextBlock
                                                            Style="{StaticResource CardMetaTextStyle}"
                                                            Text="{x:Bind MetaText}"
                                                            Visibility="{x:Bind MetaVisibility, Mode=OneWay}" />
                                                    </StackPanel>

                                                    <Button
                                                        Grid.Column="2"
                                                        Width="20"
                                                        Height="20"
                                                        Padding="0"
                                                        VerticalAlignment="Top"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="OnDeleteTaskClick"
                                                        CornerRadius="10"
                                                        Opacity="0.35"
                                                        ToolTipService.ToolTip="Delete task">
                                                        <FontIcon FontSize="9" Foreground="{StaticResource NectarInkBrush}" Glyph="&#xE711;" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Rectangle
                                                Height="1"
                                                Margin="4,2,4,0"
                                                Fill="Transparent"
                                                HorizontalAlignment="Stretch"
                                                Stroke="{StaticResource NectarInkFaintBrush}"
                                                StrokeDashArray="2,2"
                                                StrokeThickness="1" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock
                                    Margin="2,10,2,0"
                                    VerticalAlignment="Top"
                                    FontSize="11.5"
                                    Foreground="{StaticResource NectarInkMutedBrush}"
                                    Text="{x:Bind ViewModel.EmptyTasksText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.EmptyTasksVisibility, Mode=OneWay}" />
                            </Grid>

                            <Grid Grid.Row="3" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource NectarInkMutedBrush}"
                                    Glyph="&#xE710;" />
                                <TextBox
                                    x:Name="AddTaskBox"
                                    Grid.Column="1"
                                    FontSize="11.5"
                                    KeyDown="OnAddTaskKeyDown"
                                    PlaceholderText="Add a task, press Enter"
                                    Style="{StaticResource CardTextBoxStyle}" />
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Dictate a task"
                                    Click="OnTaskDictationClick"
                                    Style="{StaticResource DictationButtonStyle}"
                                    ToolTipService.ToolTip="Dictate (falls back to Win + H)">
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{StaticResource NectarInkBrush}"
                                        Glyph="&#xE720;" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Focus timer -->
                    <Border
                        x:Name="TimerCard"
                        Width="{x:Bind ViewModel.CardWidth, Mode=OneWay}"
                        Padding="13,10"
                        Background="{StaticResource NectarLilacCardBrush}"
                        BorderThickness="0"
                        CornerRadius="18"
                        Visibility="{x:Bind ViewModel.TimerCardVisibility, Mode=OneWay}">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>                                <Rectangle
                                    Grid.RowSpan="4"
                                    Fill="{StaticResource NectarPaperGrainBrush}"
                                    IsHitTestVisible="False" Opacity="0.55" />




                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="12" Foreground="{StaticResource NectarInkMutedBrush}" Glyph="&#xE916;" />
                                <TextBlock
                                    MaxLines="1"
                                    Style="{StaticResource CardTitleTextStyle}"
                                    Text="{x:Bind ViewModel.FocusTaskTitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock
                                    Style="{StaticResource TimerDisplayTextStyle}"
                                    Text="{x:Bind ViewModel.Timer.Display, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource CardMetaTextStyle}" Text="REMAINING" />
                                <ProgressBar
                                    Height="3"
                                    Margin="0,9,0,0"
                                    Background="#331B241C"
                                    CornerRadius="2"
                                    Foreground="{StaticResource NectarDeepGreenBrush}"
                                    Maximum="100"
                                    Value="{x:Bind ViewModel.Timer.ProgressPercent, Mode=OneWay}" />
                            </StackPanel>

                            <Grid Grid.Row="2" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    AutomationProperties.Name="{x:Bind ViewModel.Timer.PlayLabel, Mode=OneWay}"
                                    Click="OnTimerToggleClick"
                                    Style="{StaticResource PillActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="10" Glyph="{x:Bind ViewModel.Timer.PlayGlyph, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ViewModel.Timer.PlayLabel, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Grid.Column="1"
                                    Click="OnTimerResetClick"
                                    Style="{StaticResource CardCircleButtonStyle}"
                                    ToolTipService.ToolTip="Reset session">
                                    <FontIcon FontSize="11" Glyph="&#xE777;" />
                                </Button>
                            </Grid>

                            <Button
                                Grid.Row="3"
                                Padding="0"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Change the focus session length">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon FontSize="10" Foreground="{StaticResource NectarInkMutedBrush}" Glyph="&#xE823;" />
                                    <TextBlock Style="{StaticResource CardMetaTextStyle}" Text="Set time" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem Click="OnSetDurationClick" Tag="15" Text="15 minutes" />
                                        <MenuFlyoutItem Click="OnSetDurationClick" Tag="25" Text="25 minutes" />
                                        <MenuFlyoutItem Click="OnSetDurationClick" Tag="45" Text="45 minutes" />
                                        <MenuFlyoutItem Click="OnSetDurationClick" Tag="50" Text="50 minutes" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Notepad -->
                    <Border
                        x:Name="NotesCard"
                        Width="{x:Bind ViewModel.CardWidth, Mode=OneWay}"
                        Padding="13,10"
                        Background="{StaticResource NectarButterCardBrush}"
                        BorderThickness="0"
                        CornerRadius="18"
                        Visibility="{x:Bind ViewModel.NotesCardVisibility, Mode=OneWay}">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>                                <Rectangle
                                    Grid.RowSpan="4"
                                    Fill="{StaticResource NectarPaperGrainBrush}"
                                    IsHitTestVisible="False" Opacity="0.55" />





                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="12" Foreground="{StaticResource NectarInkMutedBrush}" Glyph="&#xE70B;" />
                                <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="Notepad" />
                            </StackPanel>

                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource CardMetaTextStyle}"
                                Text="{x:Bind ViewModel.TodayLabel}" />

                            <TextBox
                                x:Name="NoteBox"
                                Grid.Row="2"
                                KeyDown="OnNoteKeyDown"
                                PlaceholderText="Think on paper. Ctrl + Enter turns a line into a task."
                                Style="{StaticResource CardNoteTextBoxStyle}"
                                TextChanged="OnNoteTextChanged" />

                            <Grid Grid.Row="3" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource CardMetaTextStyle}" Text="{x:Bind ViewModel.NoteWordCount, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource CardMetaTextStyle}"
                                    Text="{x:Bind ViewModel.NoteStatus, Mode=OneWay}" />
                                <Button
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Dictate a note"
                                    Click="OnNoteDictationClick"
                                    Style="{StaticResource DictationButtonStyle}"
                                    ToolTipService.ToolTip="Dictate (falls back to Win + H)">
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{StaticResource NectarInkBrush}"
                                        Glyph="&#xE720;" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Events -->
                    <Border
                        x:Name="EventsCard"
                        Width="{x:Bind ViewModel.CardWidth, Mode=OneWay}"
                        Padding="13,10"
                        Background="{StaticResource NectarSkyCardBrush}"
                        BorderThickness="0"
                        CornerRadius="18"
                        Visibility="{x:Bind ViewModel.EventsCardVisibility, Mode=OneWay}">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Rectangle
                                Grid.RowSpan="4"
                                Fill="{StaticResource NectarPaperGrainBrush}"
                                IsHitTestVisible="False"
                                Opacity="0.55" />

                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="12" Foreground="{StaticResource NectarInkMutedBrush}" Glyph="&#xE787;" />
                                    <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="Events" />
                                </StackPanel>
                                <Button
                                    Width="22"
                                    Height="22"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnRefreshAgendaClick"
                                    CornerRadius="11"
                                    ToolTipService.ToolTip="Refresh today's events">
                                    <FontIcon FontSize="10" Foreground="{StaticResource NectarInkMutedBrush}" Glyph="&#xE72C;" />
                                </Button>
                            </Grid>

                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource CardMetaTextStyle}"
                                Text="{x:Bind ViewModel.AgendaSummary, Mode=OneWay}" />

                            <Grid Grid.Row="2">
                                <ScrollViewer
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Auto"
                                    VerticalScrollMode="Enabled"
                                    Visibility="{x:Bind ViewModel.AgendaListVisibility, Mode=OneWay}">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Agenda}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CalendarEventRow">
                                                <Border
                                                    Margin="0,0,0,4"
                                                    Padding="8,5"
                                                    Background="{StaticResource NectarRowBrush}"
                                                    CornerRadius="9">
                                                    <Grid ColumnSpacing="7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource CardMetaTextStyle}"
                                                            Text="{x:Bind RangeText}" />

                                                        <StackPanel
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                            <TextBlock
                                                                FontSize="11.5"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource NectarInkBrush}"
                                                                MaxLines="1"
                                                                Text="{x:Bind Subject}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Style="{StaticResource CardMetaTextStyle}"
                                                                Text="{x:Bind Location}"
                                                                Visibility="{x:Bind LocationVisibility}" />
                                                        </StackPanel>

                                                        <Button
                                                            Grid.Column="2"
                                                            Width="22"
                                                            Height="22"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="OnEventReminderClick"
                                                            CornerRadius="11"
                                                            ToolTipService.ToolTip="{x:Bind ReminderHint, Mode=OneWay}">
                                                            <FontIcon
                                                                FontSize="11"
                                                                Foreground="{x:Bind ReminderForeground, Mode=OneWay}"
                                                                Glyph="&#xE7ED;" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel
                                    VerticalAlignment="Top"
                                    Spacing="6"
                                    Visibility="{x:Bind ViewModel.AgendaEmptyVisibility, Mode=OneWay}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource NectarInkMutedBrush}"
                                        Text="{x:Bind ViewModel.AgendaHint, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Link a calendar from events"
                                        Click="OnLinkCalendarFromAgendaClick"
                                        Content="Link a calendar"
                                        Style="{StaticResource GhostActionButtonStyle}"
                                        Visibility="{x:Bind ViewModel.AgendaLinkVisibility, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Grid.Row="3"
                                Style="{StaticResource CardMetaTextStyle}"
                                Text="{x:Bind ViewModel.AgendaFooter, Mode=OneWay}" />
                        </Grid>
                    </Border>
                    <Border
                        Width="{x:Bind ViewModel.CardWidth, Mode=OneWay}"
                        Padding="16,14"
                        Background="{StaticResource NectarSkyCardBrush}"
                        BorderThickness="0"
                        CornerRadius="18"
                        Visibility="{x:Bind ViewModel.CardsEmptyVisibility, Mode=OneWay}">
                        <StackPanel VerticalAlignment="Center" Spacing="6">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource NectarInkBrush}"
                                Text="Every card is hidden" />
                            <TextBlock
                                Style="{StaticResource SettingHintTextStyle}"
                                Text="Open Customize and switch a card back on to bring your workspace back." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Insights view ===== -->
                <Grid
                    x:Name="InsightsView"
                    Grid.Row="1"
                    ColumnSpacing="16"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="316" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ===== Momentum summary: sage green ===== -->
                    <Border
                        Padding="20,18"
                        Background="{StaticResource NectarMintCardBrush}"
                        BorderThickness="0"
                        CornerRadius="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Rectangle
                                Fill="{StaticResource NectarPaperGrainBrush}"
                                IsHitTestVisible="False"
                                Opacity="0.5" />

                            <Grid RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource NectarInkBrush}"
                                    Text="{x:Bind Insights.MomentumTitle, Mode=OneWay}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,7,0,0"
                                    FontSize="12.5"
                                    Foreground="{StaticResource NectarInkBrush}"
                                    LineHeight="18"
                                    Text="{x:Bind Insights.MomentumText, Mode=OneWay}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,18,0,0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource NectarInkBrush}"
                                    Text="Last 7 days" />

                                <TextBlock
                                    Grid.Row="3"
                                    Margin="0,-6,0,-8"
                                    FontSize="64"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource NectarInkBrush}"
                                    IsTextScaleFactorEnabled="False"
                                    Text="{x:Bind Insights.TotalTasksText, Mode=OneWay}" />

                                <TextBlock
                                    Grid.Row="4"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource NectarInkBrush}"
                                    Text="Tasks completed" />

                                <TextBlock
                                    Grid.Row="5"
                                    Margin="0,7,0,0"
                                    FontSize="11.5"
                                    Foreground="{StaticResource NectarInkMutedBrush}"
                                    Text="{x:Bind Insights.PlannedText, Mode=OneWay}" />

                                <Grid Grid.Row="7" Margin="0,16,0,0" RowSpacing="9">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            FontSize="13"
                                            Foreground="{StaticResource NectarInkMutedBrush}"
                                            Glyph="&#xE823;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="9,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource NectarInkBrush}"
                                            Text="Focus time" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource NectarInkBrush}"
                                            Text="{x:Bind Insights.FocusTimeFormatted, Mode=OneWay}" />
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            FontSize="13"
                                            Foreground="{StaticResource NectarInkMutedBrush}"
                                            Glyph="&#xE787;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="9,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource NectarInkBrush}"
                                            Text="Active days" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource NectarInkBrush}"
                                            Text="{x:Bind Insights.ActiveDays, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ===== Seven-day chart: lavender ===== -->
                    <Border
                        Grid.Column="1"
                        Padding="18,16"
                        Background="{StaticResource NectarLilacCardBrush}"
                        BorderThickness="0"
                        CornerRadius="24">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Rectangle
                                Grid.RowSpan="3"
                                Fill="{StaticResource NectarPaperGrainBrush}"
                                IsHitTestVisible="False"
                                Opacity="0.5" />

                            <!-- Pill toggle on the left, window range on the right -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Padding="3"
                                    Background="{StaticResource NectarPillTrackBrush}"
                                    BorderThickness="0"
                                    CornerRadius="15">
                                    <StackPanel Orientation="Horizontal" Spacing="1">
                                        <Button
                                            AutomationProperties.Name="Show tasks chart"
                                            Background="{x:Bind Insights.TasksPillBackground, Mode=OneWay}"
                                            Command="{x:Bind Insights.ShowTasksCommand}"
                                            Content="Tasks"
                                            Foreground="{x:Bind Insights.TasksPillForeground, Mode=OneWay}"
                                            Style="{StaticResource ChartPillButtonStyle}" />
                                        <Button
                                            AutomationProperties.Name="Show focus chart"
                                            Background="{x:Bind Insights.FocusPillBackground, Mode=OneWay}"
                                            Command="{x:Bind Insights.ShowFocusCommand}"
                                            Content="Focus"
                                            Foreground="{x:Bind Insights.FocusPillForeground, Mode=OneWay}"
                                            Style="{StaticResource ChartPillButtonStyle}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,2,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CardMetaTextStyle}"
                                    Text="{x:Bind Insights.WeekRangeText, Mode=OneWay}" />
                            </Grid>

                            <!-- Plot area: hairline grid lines behind bottom-aligned columns -->
                            <Grid Grid.Row="1">
                                <Grid IsHitTestVisible="False" VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Top" Fill="Black" Opacity="0.1" />
                                    <Rectangle Grid.Row="2" Height="1" VerticalAlignment="Top" Fill="Black" Opacity="0.1" />
                                    <Rectangle Grid.Row="3" Height="1" VerticalAlignment="Top" Fill="Black" Opacity="0.1" />
                                    <Rectangle Grid.Row="4" Height="1" VerticalAlignment="Top" Fill="Black" Opacity="0.1" />
                                </Grid>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{StaticResource NectarInkMutedBrush}"
                                    Text="Finish a task or a focus session and this week fills in."
                                    Visibility="{x:Bind Insights.ChartEmptyVisibility, Mode=OneWay}" />

                                <ItemsControl
                                    VerticalAlignment="Bottom"
                                    ItemsSource="{x:Bind Insights.WeeklyChartData}"
                                    SizeChanged="OnChartPlotSizeChanged">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DailyInsight">
                                            <Grid Width="{x:Bind ColumnWidth, Mode=OneWay}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="200" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Planned behind, completed in front -->
                                                <Grid
                                                    Width="34"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom">
                                                    <Rectangle
                                                        Height="{x:Bind PlannedHeight, Mode=OneWay}"
                                                        VerticalAlignment="Bottom"
                                                        Fill="{StaticResource NectarChartPlannedBrush}"
                                                        RadiusX="4"
                                                        RadiusY="4"
                                                        Visibility="{x:Bind PlannedBarVisibility, Mode=OneWay}" />
                                                    <Rectangle
                                                        Height="{x:Bind CompletedHeight, Mode=OneWay}"
                                                        VerticalAlignment="Bottom"
                                                        Fill="{StaticResource NectarChartCompletedBrush}"
                                                        RadiusX="4"
                                                        RadiusY="4" />
                                                </Grid>

                                                <StackPanel
                                                    Grid.Row="1"
                                                    HorizontalAlignment="Center"
                                                    Spacing="2">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{StaticResource NectarInkBrush}"
                                                        Text="{x:Bind DayName}" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{StaticResource NectarInkMutedBrush}"
                                                        Text="{x:Bind DateNumber}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Legend -->
                            <StackPanel
                                Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Border
                                        Width="9"
                                        Height="9"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource NectarChartCompletedBrush}"
                                        CornerRadius="2" />
                                    <TextBlock
                                        Style="{StaticResource CardChipTextStyle}"
                                        Text="{x:Bind Insights.ChartCaption, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="7"
                                    Visibility="{x:Bind Insights.PlannedVisibility, Mode=OneWay}">
                                    <Border
                                        Width="9"
                                        Height="9"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource NectarChartPlannedBrush}"
                                        CornerRadius="2" />
                                    <TextBlock Style="{StaticResource CardChipTextStyle}" Text="Planned" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>


                <!-- ===== Customize view: General · Focus · Customize workspace ===== -->
        <Grid
            x:Name="CustomizeView"
            Grid.Row="1"
            ColumnSpacing="8"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== General ===== -->
            <Border
                Padding="14,12"
                Background="{StaticResource NectarMintCardBrush}"
                BorderThickness="0"
                CornerRadius="18">
                <Grid>
                    <Rectangle
                        Fill="{StaticResource NectarPaperGrainBrush}"
                        IsHitTestVisible="False"
                        Opacity="0.55" />
                    <ScrollViewer
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <StackPanel Spacing="9">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="12" Foreground="{StaticResource NectarInkMutedBrush}" Glyph="&#xE713;" />
                                <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="General" />
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingLabelTextStyle}" Text="Open notch with" />
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="7">
                                    <TextBlock Style="{StaticResource SettingValueTextStyle}" Text="Hover" />
                                    <ToggleSwitch
                                        AutomationProperties.Name="Open the notch on hover"
                                        IsOn="{x:Bind ViewModel.HoverToOpen, Mode=TwoWay}"
                                        Style="{StaticResource SettingsToggleStyle}"
                                        Toggled="OnHoverToggled" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingLabelTextStyle}" Text="Notch pill" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    AutomationProperties.Name="Show the collapsed notch pill"
                                    IsOn="{x:Bind ViewModel.ShowPill, Mode=TwoWay}"
                                    Style="{StaticResource SettingsToggleStyle}"
                                    Toggled="OnShowPillToggled" />
                            </Grid>

                            <TextBlock
                                Style="{StaticResource SettingHintTextStyle}"
                                Text="Off keeps Nectar out of sight: open it with the shortcut or the top edge."
                                TextWrapping="Wrap" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingLabelTextStyle}" Text="Open shortcut" />
                                <Button
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Change the open shortcut"
                                    Click="OnShortcutButtonClick"
                                    Content="{x:Bind ViewModel.ShortcutLabel, Mode=OneWay}"
                                    Style="{StaticResource GhostActionButtonStyle}" />
                            </Grid>

                            <TextBlock
                                Style="{StaticResource SettingHintTextStyle}"
                                Text="Click the shortcut, then press the keys you want. Esc cancels." />

                            <Border
                                Height="1"
                                Margin="0,2"
                                Background="{StaticResource NectarInkFaintBrush}"
                                Opacity="0.25" />

                            <TextBlock Style="{StaticResource SettingsSectionHeaderTextStyle}" Text="CALENDAR" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingLabelTextStyle}" Text="Linked calendar" />
                                <Border
                                    Grid.Column="1"
                                    Padding="8,3"
                                    Background="{StaticResource NectarChipBrush}"
                                    CornerRadius="8">
                                    <TextBlock Style="{StaticResource CardMetaTextStyle}" Text="{x:Bind ViewModel.CalendarLinkLabel, Mode=OneWay}" />
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button
                                    AutomationProperties.Name="Link a calendar"
                                    Click="OnOpenCalendarLinkClick"
                                    Content="Link calendar"
                                    Style="{StaticResource GhostActionButtonStyle}"
                                    Visibility="{x:Bind ViewModel.CalendarLinkVisibility, Mode=OneWay}" />
                                <Button
                                    AutomationProperties.Name="Disconnect the calendar"
                                    Click="OnDisconnectCalendarClick"
                                    Content="Disconnect"
                                    Style="{StaticResource GhostActionButtonStyle}"
                                    Visibility="{x:Bind ViewModel.CalendarDisconnectVisibility, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Spacing="7" Visibility="{x:Bind ViewModel.CalendarPanelVisibility, Mode=OneWay}">
                                <Border
                                    Padding="3"
                                    HorizontalAlignment="Left"
                                    Background="#26000000"
                                    CornerRadius="13">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button
                                            AutomationProperties.Name="Use Google Calendar"
                                            Background="{x:Bind ViewModel.GoogleChipBackground, Mode=OneWay}"
                                            Click="OnCalendarProviderGoogleClick"
                                            Content="Google"
                                            Foreground="{x:Bind ViewModel.GoogleChipForeground, Mode=OneWay}"
                                            Style="{StaticResource TrayChipButtonStyle}" />
                                        <Button
                                            AutomationProperties.Name="Use Microsoft Calendar"
                                            Background="{x:Bind ViewModel.MicrosoftChipBackground, Mode=OneWay}"
                                            Click="OnCalendarProviderMicrosoftClick"
                                            Content="Microsoft"
                                            Foreground="{x:Bind ViewModel.MicrosoftChipForeground, Mode=OneWay}"
                                            Style="{StaticResource TrayChipButtonStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="9,3"
                                    Background="#59FFFFFF"
                                    CornerRadius="9">
                                    <TextBox
                                        AutomationProperties.Name="OAuth client ID"
                                        FontSize="10.5"
                                        PlaceholderText="OAuth client ID"
                                        Style="{StaticResource CardTextBoxStyle}"
                                        Text="{x:Bind ViewModel.CalendarClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>

                                <Border
                                    Padding="9,3"
                                    Background="#59FFFFFF"
                                    CornerRadius="9"
                                    Visibility="{x:Bind ViewModel.CalendarTenantVisibility, Mode=OneWay}">
                                    <TextBox
                                        AutomationProperties.Name="Microsoft tenant"
                                        FontSize="10.5"
                                        PlaceholderText="Tenant (common)"
                                        Style="{StaticResource CardTextBoxStyle}"
                                        Text="{x:Bind ViewModel.CalendarTenant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>

                                <Button
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Connect the calendar"
                                    Click="OnConnectCalendarClick"
                                    Content="Connect"
                                    Style="{StaticResource SettingsPrimaryButtonStyle}" />

                                <TextBlock Style="{StaticResource SettingHintTextStyle}" Text="{x:Bind ViewModel.CalendarStatus, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource SettingHintTextStyle}"
                                    Text="Use a Desktop app OAuth client. Nectar opens your browser and returns to a local port; one calendar at a time."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border
                                Height="1"
                                Margin="0,2"
                                Background="{StaticResource NectarInkFaintBrush}"
                                Opacity="0.25" />

                            <TextBlock
                                Style="{StaticResource SettingHintTextStyle}"
                                Text="Events with a reminder ring like the focus tray: Snooze 5 min or Okay."
                                TextWrapping="Wrap" />

                            <Border
                                Height="1"
                                Margin="0,2"
                                Background="{StaticResource NectarInkFaintBrush}"
                                Opacity="0.25" />

                            <TextBlock Style="{StaticResource SettingsSectionHeaderTextStyle}" Text="PRIVACY &amp; DATA" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock Style="{StaticResource SettingLabelTextStyle}" Text="Microphone" />
                                    <TextBlock
                                        Style="{StaticResource SettingHintTextStyle}"
                                        Text="{x:Bind ViewModel.MicrophoneStatusLabel, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Open microphone privacy settings"
                                    Click="OnOpenMicrophoneSettingsClick"
                                    Content="Mic settings"
                                    Style="{StaticResource GhostActionButtonStyle}" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock Style="{StaticResource SettingLabelTextStyle}" Text="Database" />
                                    <TextBlock
                                        Style="{StaticResource SettingHintTextStyle}"
                                        Text="{x:Bind ViewModel.DatabaseStatusLabel, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Show the Nectar data folder"
                                    Click="OnRevealDataFolderClick"
                                    Content="Show folder"
                                    Style="{StaticResource GhostActionButtonStyle}" />
                            </Grid>

                            <TextBlock
                                Style="{StaticResource SettingHintTextStyle}"
                                Text="Notes and tasks are sealed with SQLCipher. db.key is protected by Windows for this account — back up the folder and the key together."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== Focus ===== -->
            <Border
                Grid.Column="1"
                Padding="14,12"
                Background="{StaticResource NectarLilacCardBrush}"
                BorderThickness="0"
                CornerRadius="18">
                <Grid>
                    <Rectangle
                        Fill="{StaticResource NectarPaperGrainBrush}"
                        IsHitTestVisible="False"
                        Opacity="0.55" />
                    <Grid RowSpacing="9">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="12" Foreground="{StaticResource NectarInkMutedBrush}" Glyph="&#xE916;" />
                            <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="Focus" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <TextBlock Style="{StaticResource SettingLabelTextStyle}" Text="Default timer" />
                            <Border
                                Padding="9,3"
                                HorizontalAlignment="Right"
                                Background="{StaticResource NectarChipBrush}"
                                CornerRadius="8">
                                <TextBlock Style="{StaticResource SettingValueTextStyle}" Text="{x:Bind ViewModel.FocusDefaultLabel}" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <TextBlock Style="{StaticResource SettingLabelTextStyle}" Text="Duration" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Click="OnFocusMinusClick"
                                    Style="{StaticResource StepperButtonStyle}"
                                    ToolTipService.ToolTip="Shorter sessions">
                                    <FontIcon FontSize="9" Glyph="&#xE738;" />
                                </Button>
                                <TextBlock
                                    MinWidth="42"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource NectarInkBrush}"
                                    Text="{x:Bind ViewModel.FocusMinutesLabel, Mode=OneWay}"
                                    TextAlignment="Center" />
                                <Button
                                    Click="OnFocusPlusClick"
                                    Style="{StaticResource StepperButtonStyle}"
                                    ToolTipService.ToolTip="Longer sessions">
                                    <FontIcon FontSize="9" Glyph="&#xE710;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="3">
                            <TextBlock Style="{StaticResource SettingLabelTextStyle}" Text="Completion sound" />
                            <ToggleSwitch
                                AutomationProperties.Name="Completion sound"
                                IsOn="{x:Bind ViewModel.CompletionSound, Mode=TwoWay}"
                                Style="{StaticResource SettingsToggleStyle}" />
                        </Grid>

                        <Grid Grid.Row="4">
                            <TextBlock Style="{StaticResource SettingLabelTextStyle}" Text="Reminder sound" />
                            <ToggleSwitch
                                AutomationProperties.Name="Reminder sound"
                                IsOn="{x:Bind ViewModel.ReminderSound, Mode=TwoWay}"
                                Style="{StaticResource SettingsToggleStyle}" />
                        </Grid>

                        <Grid Grid.Row="5">
                            <TextBlock Style="{StaticResource SettingLabelTextStyle}" Text="Chime volume" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    AutomationProperties.Name="Quieter chime"
                                    Click="OnChimeVolumeMinusClick"
                                    Style="{StaticResource StepperButtonStyle}"
                                    ToolTipService.ToolTip="Quieter chime">
                                    <FontIcon FontSize="9" Glyph="&#xE738;" />
                                </Button>
                                <TextBlock
                                    MinWidth="42"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource NectarInkBrush}"
                                    Text="{x:Bind ViewModel.ChimeVolumeLabel, Mode=OneWay}"
                                    TextAlignment="Center" />
                                <Button
                                    AutomationProperties.Name="Louder chime"
                                    Click="OnChimeVolumePlusClick"
                                    Style="{StaticResource StepperButtonStyle}"
                                    ToolTipService.ToolTip="Louder chime">
                                    <FontIcon FontSize="9" Glyph="&#xE710;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="6">
                            <TextBlock Style="{StaticResource SettingLabelTextStyle}" Text="Expiry tray" />
                            <ToggleSwitch
                                AutomationProperties.Name="Show the expiry tray"
                                IsOn="{x:Bind ViewModel.ExpiryTray, Mode=TwoWay}"
                                Style="{StaticResource SettingsToggleStyle}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="7"
                            Style="{StaticResource SettingHintTextStyle}"
                            Text="Two switches, one volume: the 00:00 completion call and the calendar reminder ring." />

                        <StackPanel Grid.Row="9" Spacing="5">
                            <Border Height="1" Background="{StaticResource NectarInkFaintBrush}" Opacity="0.25" />
                            <Grid>
                                <TextBlock Style="{StaticResource SettingsHeaderTextStyle}" Text="Permissions &amp; updates" />
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource CardMetaTextStyle}" Text="v2" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Style="{StaticResource SettingHintTextStyle}" Text="{x:Bind ViewModel.CalendarState, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource SettingHintTextStyle}" Text="Notifications: On" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Customize workspace ===== -->
            <Border
                Grid.Column="2"
                Padding="14,12"
                Background="{StaticResource NectarSkyCardBrush}"
                BorderThickness="0"
                CornerRadius="18">
                <Grid>
                    <Rectangle
                        Fill="{StaticResource NectarPaperGrainBrush}"
                        IsHitTestVisible="False"
                        Opacity="0.55" />
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="12" Foreground="{StaticResource NectarInkMutedBrush}" Glyph="&#xE15C;" />
                            <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="Customize workspace" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource SettingHintTextStyle}"
                            Text="Drag a row to reorder. Toggle to show or hide." />

                        <ListView
                            x:Name="CardSettingsList"
                            Grid.Row="2"
                            Margin="0,0,0,4"
                            Padding="0"
                            AllowDrop="True"
                            CanReorderItems="True"
                            ItemsSource="{x:Bind ViewModel.CardRows}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,5" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:CardSettingRow">
                                    <Grid
                                        Padding="9,6"
                                        Background="#59FFFFFF"
                                        ColumnSpacing="8"
                                        CornerRadius="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="{StaticResource NectarInkMutedBrush}"
                                            Glyph="{x:Bind Glyph}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource SettingLabelTextStyle}"
                                            Text="{x:Bind Title}" />
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            IsOn="{x:Bind IsVisible, Mode=TwoWay}"
                                            Style="{StaticResource SettingsToggleStyle}" />
                                        <FontIcon
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{StaticResource NectarInkFaintBrush}"
                                            Glyph="&#xE700;"
                                            ToolTipService.ToolTip="Drag to reorder" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            Grid.Row="3"
                            Style="{StaticResource SettingHintTextStyle}"
                            Text="Hidden cards keep their content." />

                        <Button
                            Grid.Row="4"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            Click="OnResetCustomizeClick"
                            Content="Reset to default"
                            Style="{StaticResource GhostActionButtonStyle}" />

                        <StackPanel Grid.Row="5" Spacing="4">
                            <Border Height="1" Background="{StaticResource NectarInkFaintBrush}" Opacity="0.25" />
                            <TextBlock Style="{StaticResource SettingsHeaderTextStyle}" Text="Look" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Padding="8,3" Background="{StaticResource NectarChipBrush}" CornerRadius="8">
                                    <TextBlock Style="{StaticResource CardMetaTextStyle}" Text="{x:Bind ViewModel.ShortcutUpperLabel, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
