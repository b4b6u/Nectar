<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder publish for a signed, self-contained Windows x64 build.

      dotnet publish Nectar/Nectar.csproj -p:PublishProfile=win-x64

  The output lands in Nectar/bin/publish/win-x64. Sign Nectar.exe there with
  scripts/sign-release.ps1 before zipping it for a release; docs/SIGNING.md walks through
  the certificate side.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Bundle the .NET runtime as well as the Windows App SDK: a folder copied to a fresh
         machine should start without a separately installed .NET 8 Desktop Runtime. -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <PublishDir>bin\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <DeleteExistingFiles>true</DeleteExistingFiles>

    <!-- One folder rather than a single file: WinUI and the Windows App SDK load native
         dependencies by name from next to the executable. -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- EF Core and WinUI are not trim-safe. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- No loose PDBs in the release folder; embedded symbols keep stack traces readable. -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
</Project>
